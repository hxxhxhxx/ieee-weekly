  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "mihexin",
  "keywords": [
    "ieee",
    "ieeexplore",
    "early-access",
    "literature-review",
    "digest",
    "llm",
    "power-amplifier",
    "gan",
    "gaas"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hxxhxhxx/ieee-weekly.git"
  },
  "bin": {
    "ieee-weekly": "./src/cli.mjs"
  },
  "scripts": {
