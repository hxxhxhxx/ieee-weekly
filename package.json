{
  "name": "dsh-ieee-weekly",
  "version": "0.1.0",
  "description": "IEEE Xplore 期刊 Early Access 关键词周报：Crossref 抓新收录 → LLM 逐篇研判 → Markdown → 邮件；同时是 DSH 插件（注册 ieee_weekly 工具）",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cli": "./src/cli.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "ieee-weekly": "./src/cli.mjs"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "LICENSE",
    "setup.ps1",
    "install-task.ps1",
    "run-weekly.cmd"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "ieee",
    "ieeexplore",
    "early-access",
    "literature-review",
    "digest",
    "llm",
    "power-amplifier",
    "gan",
    "gaas"
  ],
  "license": "MIT",
  "author": "mihexin",
  "repository": {
    "type": "git",
    "url": "https://github.com/hxxhxhxx/ieee-weekly.git"
  },
  "homepage": "https://github.com/hxxhxhxx/ieee-weekly#readme",
  "bugs": {
    "url": "https://github.com/hxxhxhxx/ieee-weekly/issues"
  },
  "scripts": {
    "run": "node src/cli.mjs",
    "dry": "node src/cli.mjs --dry-run --no-email",
    "test-mail": "node src/cli.mjs --test-mail",
    "setup": "powershell -ExecutionPolicy Bypass -File ./setup.ps1",
    "task": "powershell -ExecutionPolicy Bypass -File ./install-task.ps1",
    "plugin:check": "node tools/plugin-check.mjs"
  },
  "dependencies": {
    "nodemailer": "^7.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.4",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "node": ">=20"
  }
}
